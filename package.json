{
  "name": "prz-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy:full": "npm run db:migrate:local && npm run db:seed:local && npm run deploy",
    "db:create": "wrangler d1 create prz-tours-new",
    "db:migrate:local": "wrangler d1 migrations apply prz-tours-new --local",
    "db:migrate:remote": "wrangler d1 migrations apply prz-tours-new --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "db:reset:local": "wrangler d1 execute prz-tours-new --local --file=./scripts/reset.sql && npm run db:migrate:local",
    "test:mobile": "node scripts/mobile-test.mjs",
    "test:desktop": "node scripts/mobile-test.mjs --desktop",
    "test:booking": "node scripts/test-booking.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:loyalty": "node scripts/test-loyalty.mjs",
    "test:categories": "node scripts/test-categories.mjs",
    "test:prod": "node scripts/test-prod-booking.mjs",
    "test:email": "node scripts/test-email.mjs",
    "test:imagekit": "node scripts/test-imagekit.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:gallery:admin": "node scripts/test-gallery-admin.mjs",
    "test:upload": "node scripts/test-upload.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "secrets": "node scripts/with-secrets.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "unrs-resolver@1.12.2": true
  }
}
